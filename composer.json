{
    "name": "ticketia/ticketia",
    "description": "Helpdesk open source con IA: triage automatico, soporte multilingue y analisis del backlog. Self-hosted, con soporte de IA 100% local.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/ticketia/ticketia",
    "keywords": ["helpdesk", "tickets", "ia", "llm", "self-hosted", "soporte"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "phpmailer/phpmailer": "^7.1",
        "robmorgan/phinx": "^0.16",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "TicketIA\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "instalar": "php bin/instalar.php",
        "migrar": "phinx migrate -e principal",
        "semillas": "phinx seed:run -e principal"
    }
}
