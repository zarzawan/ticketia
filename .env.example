# =============================================================
# TicketIA — configuracion de entorno
# Copia este fichero a .env y ajusta los valores. El fichero .env
# NUNCA debe subirse al repositorio.
# =============================================================

# --- Base de datos (MySQL/MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ticketia
DB_USER=ticketia
DB_PASS=

# --- Proveedor de IA activo: local | openai | xai ---
# Tambien puede cambiarse desde el panel. Si el proveedor configurado
# no esta disponible, se usa el primero que lo este.
LLM_PROVIDER=local

# --- IA local (cualquier servidor compatible con la API de OpenAI) ---
# LM Studio:  http://localhost:1234/v1/chat/completions
# Ollama:     http://localhost:11434/v1/chat/completions
LLM_LOCAL_ENDPOINT=http://localhost:1234/v1/chat/completions
# Identificador del modelo cargado en tu servidor local (ej. llama3.1:8b)
LLM_LOCAL_MODEL=
# Solo si tu servidor local exige clave
LLM_LOCAL_API_KEY=

# --- OpenAI (opcional, de pago: requiere tu propia clave) ---
OPENAI_API_KEY=
#OPENAI_MODEL=gpt-5
#OPENAI_MODEL_STREAM=gpt-4.1-mini

# --- xAI (opcional, de pago: requiere tu propia clave) ---
XAI_API_KEY=
#XAI_MODEL=grok-3
#XAI_MODEL_STREAM=grok-3-mini-beta

# --- Tiempos de espera de la IA (segundos) ---
LLM_CONNECT_TIMEOUT=5
LLM_TIMEOUT=120
LLM_TIMEOUT_TRADUCTOR=60
