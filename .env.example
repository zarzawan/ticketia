# =============================================================
# TicketIA — configuracion de entorno
# Copia este fichero a .env y ajusta los valores. El fichero .env
# NUNCA debe subirse al repositorio.
# =============================================================

# --- Base de datos (MySQL/MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ticketia
DB_USER=ticketia
DB_PASS=cambia-esta-contrasena

# Solo Docker Compose: clave administrativa de MariaDB y puerto publico.
DB_ROOT_PASS=cambia-esta-contrasena-root
APP_PORT=8080

# Cifra los secretos 2FA. Genera una clave unica con:
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=

# --- Proveedor de IA activo: local | openai | xai ---
# Tambien puede cambiarse desde el panel. Si el proveedor configurado
# no esta disponible, se usa el primero que lo este.
LLM_PROVIDER=local

# --- IA local (cualquier servidor compatible con la API de OpenAI) ---
# LM Studio:  http://localhost:1234/v1/chat/completions
# Ollama:     http://localhost:11434/v1/chat/completions
LLM_LOCAL_ENDPOINT=http://localhost:1234/v1/chat/completions
# Identificador del modelo cargado en tu servidor local (ej. llama3.1:8b)
LLM_LOCAL_MODEL=
# Solo si tu servidor local exige clave
LLM_LOCAL_API_KEY=

# --- OpenAI (opcional, de pago: requiere tu propia clave) ---
OPENAI_API_KEY=
#OPENAI_MODEL=gpt-5
#OPENAI_MODEL_STREAM=gpt-4.1-mini

# --- xAI (opcional, de pago: requiere tu propia clave) ---
XAI_API_KEY=
#XAI_MODEL=grok-3
#XAI_MODEL_STREAM=grok-3-mini-beta

# --- Control de coste de la IA ---
# 1 = ignorar los proveedores de pago aunque haya claves (coste cero, privacidad total)
LLM_SOLO_LOCAL=0
# Maximo de llamadas al dia a proveedores DE PAGO (0 = sin limite). La IA local no se limita.
LLM_MAX_LLAMADAS_DIA=0
# Retencion de trazas de IA (7-730 dias). El worker limpia por lotes.
LLM_LOG_RETENTION_DIAS=90

# --- Tiempos de espera de la IA (segundos) ---
LLM_CONNECT_TIMEOUT=5
LLM_TIMEOUT=120
# Alerta administrativa sin actividad CLI. Mayor que el intervalo de cron y una tarea.
WORKER_ALERTA_SEGUNDOS=600
LLM_TIMEOUT_TRADUCTOR=60

# --- Adjuntos ---
# Tamano maximo por fichero en MB
ADJUNTOS_MAX_MB=10

# --- Notificaciones por email (opcional) ---
# Sin SMTP_HOST no se envia ningun correo y la aplicacion funciona igual.
# URL publica de la aplicacion, usada en los enlaces de los correos.
APP_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
# Seguridad: tls | ssl | none
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=soporte@tu-dominio.example
SMTP_FROM_NAME=TicketIA
